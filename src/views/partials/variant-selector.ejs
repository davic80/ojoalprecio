<%
  // Locals: selector = SelectorRow[]  (lib/groups.ts buildSelector) — Amazon-style option rows.
  const eur = (n) => Number(n).toFixed(2).replace('.', ',') + ' €';
%>
<style>
  .opt-row { margin: 10px 0 0; }
  .opt-row h3 { font-size: 13px; margin: 0 0 6px; color: var(--gray-600, #4b5563); font-weight: 600; }
  .opt-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt-chip { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 64px; padding: 6px 10px;
    border: 1px solid var(--gray-300, #d1d5db); border-radius: 8px; font-size: 13px; line-height: 1.25; text-decoration: none;
    color: inherit; background: var(--bg, transparent); }
  a.opt-chip:hover { border-color: var(--primary, #e63946); }
  .opt-chip.is-current { border: 2px solid var(--primary, #e63946); font-weight: 600; }
  .opt-chip.is-off { opacity: .5; text-decoration: line-through; cursor: default; }
  .opt-chip .opt-price { font-size: 12px; color: var(--gray-600, #4b5563); font-weight: 400; text-decoration: none; }
  .opt-chip .opt-follow { font-size: 11px; color: var(--primary, #e63946); }
</style>
<div class="card" id="variant-selector" style="margin-top:20px">
  <h2 style="margin:0 0 2px;font-size:16px">Elige la opción</h2>
  <p class="hint" style="margin:0">Cada opción es un producto con su propio precio y su propio aviso.</p>
  <% selector.forEach(function(row) { %>
    <div class="opt-row">
      <h3><%= row.title %></h3>
      <div class="opt-chips">
        <% row.options.slice(0, 80).forEach(function(o) {
          const cls = 'opt-chip' + (o.current ? ' is-current' : '') + ((!o.available || !o.inCatalog) && !o.current ? ' is-off' : '');
          const inner = '<span>' + o.label.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</span>'
            + (o.price !== null ? '<span class="opt-price">' + eur(o.price) + '</span>' : (o.inCatalog && o.available ? '<span class="opt-price">…</span>' : ''))
            + (o.followed ? '<span class="opt-follow">✓ la sigues</span>' : ''); %>
          <% if (o.current) { %>
            <span class="<%= cls %>" aria-current="true"><%- inner %></span>
          <% } else if (o.inCatalog) { %>
            <a class="<%= cls %>" href="/p/<%= o.asin %>"><%- inner %></a>
          <% } else { %>
            <span class="<%= cls %>" title="Amazon no lo tiene disponible"><%- inner %></span>
          <% } %>
        <% }); %>
      </div>
      <% if (row.options.length > 80) { %><p class="hint">Mostrando 80 de <%= row.options.length %>.</p><% } %>
    </div>
  <% }); %>
</div>
