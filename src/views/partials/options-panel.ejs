<%
  // Locals: options = { asin, current, others[], pending, open }  (built by buildOptionsView in routes/public.ts)
  const o = options;
  const eur = (n) => (n === null || n === undefined) ? '—' : Number(n).toFixed(2).replace('.', ',') + ' €';
  const back = '/p/' + o.asin + '?opciones=1';
  const inputStyle = 'width:120px;padding:6px 8px;border:1px solid var(--gray-300,#d1d5db);border-radius:6px;font-size:14px';
%>
<div id="options-panel" class="card" style="margin-top:20px;<%= o.open ? 'border-left:3px solid var(--primary,#e63946)' : '' %>"
  <% if (o.pending) { %>hx-get="/p/<%= o.asin %>/fragment/options?opciones=1" hx-trigger="every 4s" hx-swap="outerHTML"<% } %>>
  <h2 style="margin-top:0;font-size:16px">Tus opciones y precios</h2>
  <% if (o.open) { %>
    <p class="hint" style="margin:0 0 12px">✓ Producto añadido. Indica a qué precio quieres que te avisemos para <strong>esta opción</strong>; si el producto tiene más opciones (color, tamaño…), puedes añadir otra y ponerle su propio precio.</p>
  <% } else { %>
    <p class="hint" style="margin:0 0 12px">Cada opción (color, tamaño…) es un producto distinto con su precio. Pon el precio que te interesa para cada una.</p>
  <% } %>

  <!-- Esta opción -->
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 0;border-top:1px solid var(--gray-200,#e5e7eb)">
    <div>
      <div style="font-weight:600"><%= o.current.label %> <span class="hint" style="font-weight:400">(la de tu enlace)</span></div>
      <div class="hint">Precio ahora: <%= eur(o.current.price) %><% if (o.current.available === false) { %> · sin stock<% } %><% if (o.current.followed) { %> · ✓ la sigues<% } %></div>
    </div>
    <% if (o.current.productId) { %>
    <form method="POST" action="/products/<%= o.current.productId %>/price-alert" style="display:flex;gap:6px;align-items:center">
      <input type="hidden" name="next" value="<%= back %>">
      <label class="hint" for="thr-cur" style="white-space:nowrap">Avísame si baja de</label>
      <input id="thr-cur" name="threshold" inputmode="decimal" placeholder="€" value="<%= o.current.threshold ? String(o.current.threshold).replace('.', ',') : '' %>" style="<%= inputStyle %>" required>
      <button type="submit" class="btn btn-sm btn-primary"><%= o.current.threshold ? 'Actualizar' : 'Guardar' %></button>
    </form>
    <% } %>
  </div>

  <!-- Otras opciones -->
  <% if (o.pending) { %>
    <p class="hint" style="margin:10px 0 0">Leyendo las demás opciones de Amazon (color, tamaño…). Esta sección se actualiza sola en unos segundos.</p>
  <% } else if (o.others.length) { %>
    <details style="margin-top:6px;border-top:1px solid var(--gray-200,#e5e7eb);padding-top:10px">
      <summary style="cursor:pointer;font-weight:600">+ Seguir otra opción de este producto <span class="hint" style="font-weight:400">(<%= o.others.length %>)</span></summary>
      <% o.others.slice(0, 40).forEach(function(v, i) { %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:8px 0;<%= v.selectable ? '' : 'opacity:.6' %>">
          <div>
            <div style="font-weight:500"><%= v.label %></div>
            <div class="hint">
              <% if (v.price !== null) { %>Precio ahora: <%= eur(v.price) %><% if (v.available === false) { %> · sin stock<% } %><% } else { %>Aún sin precio (lo leeremos al añadirla)<% } %>
              <% if (v.followed) { %> · ✓ la sigues<% } %>
              · <a href="https://www.amazon.es/dp/<%= v.asin %>" target="_blank" rel="noopener nofollow">ver en Amazon</a>
            </div>
          </div>
          <form method="POST" action="/products" style="display:flex;gap:6px;align-items:center">
            <input type="hidden" name="url" value="https://www.amazon.es/dp/<%= v.asin %>">
            <input type="hidden" name="next" value="<%= back %>">
            <label class="hint" for="thr-<%= i %>" style="white-space:nowrap">Avísame si baja de</label>
            <input id="thr-<%= i %>" name="threshold" inputmode="decimal" placeholder="€" value="<%= v.threshold ? String(v.threshold).replace('.', ',') : '' %>" style="<%= inputStyle %>" required>
            <button type="submit" class="btn btn-sm <%= v.followed ? 'btn-outline' : 'btn-primary' %>"><%= v.followed ? 'Actualizar' : 'Seguir' %></button>
          </form>
        </div>
      <% }); %>
      <% if (o.others.length > 40) { %><p class="hint">Mostrando 40 de <%= o.others.length %> opciones.</p><% } %>
    </details>
  <% } %>
</div>
