<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title: 'Iniciar sesión — OjoAlPrecio' }) %>
</head>
<body class="auth-page">

<%- include('partials/auth-card-header', { tagline: 'Seguimiento de precios en Amazon.es' }) %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert-box" style="background:var(--green-light,#f0fdf4); border:1px solid var(--green); color:#166534; margin-bottom:16px;"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert-box alert-error"><%= error %></div>
  <% } %>

  <% if (typeof googleEnabled !== 'undefined' && googleEnabled) { %>
    <%- include('partials/google-button', { next: typeof next !== 'undefined' ? next : null }) %>
    <p class="auth-alt" style="margin:14px 0;color:var(--text-muted);font-size:13px">o con tu email</p>
  <% } %>

  <form action="/auth/login" method="POST" class="auth-form">
    <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
    <div class="form-field">
      <label for="email">Email</label>
      <input
        type="email"
        name="email"
        id="email"
        value="<%= email %>"
        required
        autocomplete="email"
        class="input"
        placeholder="tu@email.com"
      >
    </div>
    <div class="form-field">
      <label for="password">Contraseña</label>
      <input
        type="password"
        name="password"
        id="password"
        required
        autocomplete="current-password"
        class="input"
        placeholder="••••••••"
      >
    </div>
    <button type="submit" class="btn btn-primary btn-full">Iniciar sesión</button>
  </form>

  <p class="auth-alt">
    <a href="/auth/forgot" style="font-size:13px; color:var(--text-muted)">¿Olvidaste tu contraseña?</a>
  </p>
  <p class="auth-alt">
    ¿No tienes cuenta? <% if (typeof googleEnabled !== 'undefined' && googleEnabled && typeof passwordSignup !== 'undefined' && !passwordSignup) { %>Entra con Google y se crea sola.<% } else { %><a href="/auth/register">Regístrate</a><% } %>
  </p>
</div>

</body>
</html>
