<%
const fmt = (n, d) => n === null || n === undefined ? '—' : Number(n).toLocaleString('es-ES', { maximumFractionDigits: d === undefined ? 0 : d });
const madrid = (ms, o) => new Date(ms).toLocaleString('es-ES', Object.assign({ timeZone: 'Europe/Madrid' }, o));
const dur = (ms) => { const m = Math.floor(ms / 60000); if (m < 60) return m + ' min'; const h = Math.floor(m / 60); return h < 48 ? h + ' h ' + (m % 60) + ' min' : Math.floor(h / 24) + ' d ' + (h % 24) + ' h'; };
const levelBadge = (m) => !m.reachable ? ['sin respuesta', '#b53847'] : m.paused ? ['en pausa', '#b45309'] : m.breakerOpen ? ['interruptor abierto', '#b45309'] : m.level === 'critical' ? ['crítico', '#b53847'] : m.level === 'warn' ? ['aviso', '#b45309'] : ['ok', '#198754'];
%>
<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title: 'Salud y rendimiento — Admin OjoAlPrecio' }) %>
</head>
<body>

<%- include('partials/navbar-admin', { user, activePage: 'salud' }) %>

<main class="container">

  <div class="page-header">
    <h1>Salud y rendimiento</h1>
    <p class="subtitle">Ejecutores, ritmo de lectura, máquinas, visitantes y aplicación &nbsp;·&nbsp; generado a las <%= madrid(generatedAt, { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %> (hora de España) &nbsp;·&nbsp; <a href="/admin/ops" class="hint-link">Ops →</a></p>
    <div style="display:flex;gap:8px;margin-top:8px">
      <% [['24h', 'Últimas 24 h'], ['7d', 'Últimos 7 días']].forEach(function(t) { %>
        <a href="/admin/salud?r=<%= t[0] %>" style="padding:5px 12px;border-radius:999px;font-size:13px;border:1px solid var(--gray-300, #d1d5db);<%= range === t[0] ? 'background:#1d4ed8;color:#fff;border-color:#1d4ed8' : 'color:inherit' %>"><%= t[1] %></a>
      <% }); %>
    </div>
  </div>

  <!-- Visitors -->
  <div class="stats-bar" style="margin-bottom:16px">
    <div class="stat-pill"><span class="stat-pill-value" id="live-active"><%= visitors.live.active %></span><span class="stat-pill-label">visitantes ahora (5 min) <span id="live-dot" style="color:#198754">●</span></span></div>
    <div class="stat-pill"><span class="stat-pill-value" id="live-logged"><%= visitors.live.loggedIn %></span><span class="stat-pill-label">con sesión ahora</span></div>
    <div class="stat-pill"><span class="stat-pill-value" id="live-uniques"><%= fmt(visitors.live.uniquesToday) %></span><span class="stat-pill-label">únicos hoy*</span></div>
    <div class="stat-pill"><span class="stat-pill-value" id="live-peak"><%= visitors.live.peakToday %></span><span class="stat-pill-label">pico simultáneo hoy*</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(visitors.viewsToday) %></span><span class="stat-pill-label">páginas vistas hoy</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(visitors.usersTotal) %></span><span class="stat-pill-label">usuarios registrados</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= visitors.new24h %> / <%= visitors.new7d %></span><span class="stat-pill-label">altas 24 h / 7 días</span></div>
  </div>

  <div class="card" style="margin-bottom:16px">
    <h2>Visitantes <span class="hint">— <%= range === '7d' ? 'últimos 7 días, máximo de cada hora' : 'últimas 24 h, máximo de cada 10 min' %></span></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:12px">
      <div>
        <div style="display:flex;justify-content:space-between;font-size:12px"><span>Visitantes activos (ventana de 5 min)</span><strong>máx <%= fmt(visitors.activeSummary.max) %></strong></div>
        <%- visitors.activeSvg %>
      </div>
      <div>
        <div style="font-size:12px">Usuarios con sesión activos</div>
        <%- visitors.loggedSvg %>
      </div>
      <div>
        <div style="font-size:12px;margin-bottom:2px">Visitantes únicos por día — últimos 14 días</div>
        <div style="display:flex;align-items:flex-end;gap:3px;height:48px">
          <% visitors.daily.forEach(function(d) { %>
            <div class="chart-bar" data-tip="<%= d.day %> · <%= d.uniques %> únicos · pico <%= d.peak %>" style="flex:1;height:<%= Math.max(3, Math.round(d.uniques / visitors.maxDaily * 46)) %>px;background:#1d4ed8;border-radius:2px 2px 0 0;min-width:4px"></div>
          <% }); %>
          <% if (!visitors.daily.length) { %><span class="hint">sin datos todavía</span><% } %>
        </div>
      </div>
    </div>
    <p class="hint" style="margin-top:8px">Cuenta personas, no bots, sin guardar IP ni identificadores: solo recuentos. * «Únicos» y «pico» se reconstruyen en memoria y pueden quedarse cortos el día de un despliegue; las gráficas empiezan al activar esta función.</p>
  </div>

  <!-- Scraping -->
  <div class="stats-bar" style="margin-bottom:16px">
    <div class="stat-pill"><span class="stat-pill-value" style="color:<%= scraping.ok ? '#198754' : '#b53847' %>"><%= scraping.ok ? 'sano' : (scraping.stuck ? 'atascado' : 'sin respuestas') %></span><span class="stat-pill-label">scraping</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.lastHour) %></span><span class="stat-pill-label">lecturas última hora completa</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.totalRange) %></span><span class="stat-pill-label">lecturas en <%= range === '7d' ? '7 días' : '24 h' %></span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.avgAgeH, 1) %> h</span><span class="stat-pill-label">edad media de la última lectura</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.read24h) %>/<%= fmt(scraping.total) %></span><span class="stat-pill-label">productos leídos en 24 h</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.queueDone) %>/<%= fmt(scraping.queueTotal) %></span><span class="stat-pill-label">cola actual</span></div>
    <div class="stat-pill"><span class="stat-pill-value"><%= fmt(scraping.failed) %></span><span class="stat-pill-label">productos con fallo</span></div>
  </div>

  <div class="card" style="margin-bottom:16px">
    <h2>Lecturas <%= range === '7d' ? 'por día — últimos 7 días' : 'por hora — últimas 24 h' %></h2>
    <div style="font-size:11px;color:var(--gray-400);text-align:right;margin-top:8px">máx: <%= fmt(maxBar) %></div>
    <div style="display:flex;align-items:flex-end;gap:<%= range === '7d' ? 8 : 3 %>px;height:90px;padding:0 2px">
      <% bars.forEach(function(h) { const px = h.n > 0 ? Math.max(3, Math.round((h.n / maxBar) * 86)) : 0; %>
        <div class="chart-bar" data-tip="<%= h.tip %> · <%= fmt(h.n) %> lecturas<%= h.partial ? ' (incompleto)' : '' %>"
             style="flex:1;height:<%= px %>px;background:<%= h.partial ? '#93c5fd' : '#1d4ed8' %>;border-radius:2px 2px 0 0;min-width:4px;align-self:flex-end"></div>
      <% }); %>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:11px;color:var(--gray-400)">
      <span><%= bars[0].label %></span>
      <span>ahora (barra clara = periodo incompleto)</span>
    </div>
  </div>

  <!-- Executors -->
  <div class="card" style="margin-bottom:16px">
    <h2>Ejecutores</h2>
    <div class="table-wrap">
      <table class="data-table" style="width:100%;margin-top:8px">
        <thead><tr><th style="text-align:left">Ejecutor</th><th style="text-align:left">Estado</th><th style="text-align:right">Hechas*</th><th style="text-align:right">Fallos*</th><th style="text-align:left">Último error</th></tr></thead>
        <tbody>
        <% machines.forEach(function(m) { const b = levelBadge(m); %>
          <tr>
            <td><strong><%= m.name %></strong> <span class="hint">(<%= m.kind === 'local' ? 'servidor' : 'remoto' %>)</span></td>
            <td><span style="color:<%= b[1] %>;font-weight:600">● <%= b[0] %></span></td>
            <td style="text-align:right"><%= fmt(m.done) %></td>
            <td style="text-align:right"><%= fmt(m.failed) %></td>
            <td class="hint"><%= m.lastError || '—' %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <p class="hint" style="margin-top:8px">* desde el último reinicio de la app. Un ejecutor se pausa solo tras 2 comprobaciones críticas seguidas.</p>
  </div>

  <!-- Machines -->
  <% machines.forEach(function(m) { %>
    <div class="card" style="margin-bottom:16px">
      <h2><%= m.kind === 'local' ? 'Servidor' : 'Pi' %> · <%= m.name %> <span class="hint">— <%= range === '7d' ? 'últimos 7 días, un punto por hora' : 'últimas 24 h, un punto cada 10 min' %></span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:12px">
        <% m.charts.forEach(function(c) { %>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12px"><span><%= c.label %></span><strong><%= fmt(c.last, c.key === 'load' ? 2 : (c.key === 'temp' ? 1 : 0)) %> <span class="hint"><%= c.unit %></span></strong></div>
            <%- c.svg %>
            <div class="hint" style="font-size:11px">mín <%= fmt(c.min, c.key === 'load' ? 2 : 0) %> · máx <%= fmt(c.max, c.key === 'load' ? 2 : 0) %></div>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>

  <!-- App -->
  <div class="card" style="margin-bottom:16px">
    <h2>Aplicación y base de datos</h2>
    <div class="stats-bar" style="margin-top:12px">
      <div class="stat-pill"><span class="stat-pill-value"><%= app.version %><%= app.commit ? ' · ' + app.commit : '' %></span><span class="stat-pill-label">versión</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= dur(app.uptimeMs) %></span><span class="stat-pill-label">en marcha</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.rssMb) %> MB</span><span class="stat-pill-label">memoria de la app (heap <%= fmt(app.heapMb) %>)</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.dbPingMs) %> ms</span><span class="stat-pill-label">latencia de la BD</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.dbMb) %> MB</span><span class="stat-pill-label">tamaño de la BD</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.priceRows) %></span><span class="stat-pill-label">filas de precios (aprox.)</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.activeProducts) %></span><span class="stat-pill-label">productos activos</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= app.diskPct === null ? '—' : app.diskPct + ' %' %></span><span class="stat-pill-label">disco usado (<%= fmt(app.diskFreeGb, 1) %> GB libres)</span></div>
      <div class="stat-pill"><span class="stat-pill-value"><%= fmt(app.hostMemAvailMb) %> / <%= fmt(app.hostMemTotalMb) %> MB</span><span class="stat-pill-label">memoria libre del servidor</span></div>
    </div>
  </div>

</main>
<div id="chart-tooltip" style="display:none;position:fixed;background:#111827;color:#fff;padding:5px 10px;border-radius:6px;font-size:12px;pointer-events:none;z-index:1000;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.3)"></div>
<script>
(function () {
  var tip = document.getElementById('chart-tooltip');
  function place(e) { tip.style.left = Math.min(window.innerWidth - tip.offsetWidth - 8, e.clientX + 14) + 'px'; tip.style.top = (e.clientY - 36) + 'px'; }
  document.querySelectorAll('.chart-bar').forEach(function (bar) {
    bar.style.cursor = 'default';
    bar.addEventListener('mouseover', function (e) { tip.textContent = bar.dataset.tip; tip.style.display = 'block'; place(e); });
    bar.addEventListener('mousemove', place);
    bar.addEventListener('mouseout', function () { tip.style.display = 'none'; });
    bar.addEventListener('touchstart', function (e) { var t = e.touches[0]; tip.textContent = bar.dataset.tip; tip.style.display = 'block'; place(t); setTimeout(function () { tip.style.display = 'none'; }, 2500); }, { passive: true });
  });
})();
</script>
<script>
(function () {
  var ids = { active: 'live-active', loggedIn: 'live-logged', uniquesToday: 'live-uniques', peakToday: 'live-peak' };
  function tick() {
    fetch('/admin/salud/live', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
      if (!d) return;
      Object.keys(ids).forEach(function (k) { var el = document.getElementById(ids[k]); if (el) el.textContent = Number(d[k]).toLocaleString('es-ES'); });
      var dot = document.getElementById('live-dot'); if (dot) dot.style.opacity = dot.style.opacity === '0.3' ? '1' : '0.3';
    }).catch(function () {});
  }
  setInterval(tick, 15000);
})();
</script>
</body>
</html>
