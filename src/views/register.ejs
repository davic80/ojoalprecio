<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title: 'Crear cuenta — OjoAlPrecio' }) %>
</head>
<body class="auth-page">

<%- include('partials/auth-card-header', { tagline: 'Crea tu cuenta' }) %>

  <% if (error) { %>
    <div class="alert-box alert-error"><%= error %></div>
  <% } %>

  <% if (typeof googleEnabled !== 'undefined' && googleEnabled) { %>
    <%- include('partials/google-button', { next: typeof next !== 'undefined' ? next : null }) %>
    <% if (typeof passwordSignup === 'undefined' || passwordSignup) { %><p class="auth-alt" style="margin:14px 0;color:var(--text-muted);font-size:13px">o con tu email</p><% } %>
  <% } %>

  <% if (typeof passwordSignup !== 'undefined' && !passwordSignup) { %>
    <p class="hint" style="text-align:center;margin:14px 0">El registro se hace con tu cuenta de Google: no necesitas contraseña ni verificar el email.</p>
  <% } else { %>
  <form action="/auth/register" method="POST" class="auth-form">
    <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
    <div class="form-field">
      <label for="email">Email</label>
      <input
        type="email"
        name="email"
        id="email"
        value="<%= email %>"
        required
        autocomplete="email"
        class="input"
        placeholder="tu@email.com"
      >
    </div>
    <div class="form-field">
      <label for="password">Contraseña</label>
      <input
        type="password"
        name="password"
        id="password"
        required
        autocomplete="new-password"
        class="input"
        placeholder="Mínimo 8 caracteres"
        minlength="8"
      >
    </div>
    <div class="form-field">
      <label for="passwordConfirm">Confirmar contraseña</label>
      <input
        type="password"
        name="passwordConfirm"
        id="passwordConfirm"
        required
        autocomplete="new-password"
        class="input"
        placeholder="Repite tu contraseña"
      >
    </div>
    <%# Honeypot: invisible to people, bots fill every field. -%>
    <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
      <label>Web <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-language="es" style="margin:12px 0"></div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
    <button type="submit" class="btn btn-primary btn-full">Crear cuenta</button>
  </form>
  <% } %>

  <p class="auth-alt">
    ¿Ya tienes cuenta? <a href="/auth/login">Inicia sesión</a>
  </p>
</div>

</body>
</html>
